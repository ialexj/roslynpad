<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="RoslynPadLocal" value="./nupkg" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="RoslynPadLocal">
      <package pattern="RoslynPad.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
